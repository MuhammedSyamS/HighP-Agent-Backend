# Dependencies
node_modules/
.pnp
.pnp.js

# Build and Transpiled Outputs
dist/
build/
out/
*.tsbuildinfo

# Environment & Sensitive Credentials
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example

# Logs and Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Serverless & Hosting Platform Caches
.vercel/
.serverless/
.turbo/

# OS-Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Temporary Diagnostic Scripts
src/scripts/test*.js
src/scripts/check*.js