# ==============================================================================
# HighP Workforce Telemetry & Attendance Backend - Environment Template
# ==============================================================================

NODE_ENV=development
PORT=5000

# Application Details
APP_NAME="HighP Workforce Telemetry & Attendance"
CLIENT_URL=http://localhost:3000

# Database Connectivity (MongoDB Atlas Cluster / Local URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/highphaus?retryWrites=true&w=majority

# Security & Authentication (JWT 256-bit secrets)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_characters
JWT_REFRESH_EXPIRES_IN=30d

# Cross-Origin Resource Sharing (CORS) Whitelist
CORS_ORIGIN=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

# Workstation Telemetry Cadence & Thresholds
DEFAULT_IDLE_THRESHOLD_MINUTES=5
DEFAULT_HEARTBEAT_INTERVAL_SECONDS=30

# Optional Redis Pub/Sub (Socket.IO Adapter)
# REDIS_URL=redis://default:password@localhost:6379

# Email / SMTP Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM="HighP Monitor <your_email@gmail.com>"
# Google Apps Script Webhook Relay (Bypasses cloud SMTP egress firewall over HTTPS Port 443)
GMAIL_WEBHOOK_URL=""
